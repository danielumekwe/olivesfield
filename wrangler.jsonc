{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olivesfield-school",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Builds the static site into ./out before every deploy, so Cloudflare's
  // default deploy command (npx wrangler deploy) works without extra settings.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "info@olivesfieldschool.com.ng",
    "CONTACT_FROM": "Olivesfield School Website <website@olivesfieldschool.com.ng>"
  },
  "observability": { "enabled": true }
  // After approval, attach the production domain:
  // "routes": [{ "pattern": "olivesfieldschool.com.ng", "custom_domain": true }]
}
